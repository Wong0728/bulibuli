{
  "name": "bulibuli-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "补哩补哩 bulibuli - 前端（Vue 3 + Vite）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b --noEmit && vite build",
    "build:nocheck": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test:smoke": "playwright test --config playwright.config.mjs",
    "test:e2e": "playwright test --config playwright.real-backend.mjs"
  },
  "dependencies": {
    "pinia": "^2.2.0",
    "socket.io-client": "^4.7.5",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "typescript": "^5.5.0",
    "vite": "^6.4.3",
    "vue-tsc": "^2.1.0"
  }
}
